{
  "appId": "com.aimatch.app",
  "productName": "Ai-Match",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    ".vite/**/*",
    "package.json",
    "assets/**/*",
    "!**/*.map",
    "!**/*.log",
    "!**/node_modules/@ant-design/**/*",
    "!**/node_modules/antd/**/*",
    "!**/node_modules/axios/**/*",
    "!**/node_modules/react/**/*",
    "!**/node_modules/react-dom/**/*",
    "!**/node_modules/tailwindcss/**/*",
    "!**/.git/**/*",
    "!**/.vscode/**/*",
    "!**/src/**/*",
    "!**/*.ts",
    "!**/*.tsx",
    "!**/test/**/*",
    "!**/tests/**/*",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/README.md",
    "!**/README.*.md",
    "!**/.gitignore",
    "!**/.eslintrc*",
    "!**/tsconfig.json",
    "!**/vite.*.config.*",
    "!**/forge.config.*",
    "!**/electron-builder.json"
  ],
  "extraFiles": [
    {
      "from": "node_modules/electron/dist",
      "to": ".",
      "filter": [
        "icudtl.dat",
        "resources.pak",
        "v8_context_snapshot.bin",
        "version",
        "vk_swiftshader.dll"
      ]
    },
    {
      "from": "node_modules/electron/dist/locales",
      "to": "locales",
      "filter": [
        "en-US.pak",
        "en-GB.pak",
        "zh-CN.pak",
        "zh-TW.pak"
      ]
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icons/appIcon.ico",
    "forceCodeSigning": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/icons/appIcon.icns",
    "category": "public.app-category.utilities",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "entitlements": null,
    "entitlementsInherit": null
  },
  "dmg": {
    "title": "${productName}",
    "icon": "assets/icons/appIcon.icns",
    "background": null,
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 400
    }
  },
  "asar": true,
  "compression": "maximum",
  "nsis": {
    "allowToChangeInstallationDirectory": true,
    "oneClick": false,
    "installerIcon": "assets/icons/appIcon.ico",
    "uninstallerIcon": "assets/icons/appIcon.ico",
    "installerHeaderIcon": "assets/icons/appIcon.ico",
    "createDesktopShortcut": true,
    "runAfterFinish": true,
    "language": "2052",
    "deleteAppDataOnUninstall": false
  }
}